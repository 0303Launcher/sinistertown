        end
    end
    return nil
end

local function findSilentAimTarget()
    if not hasGunScript(LocalPlayer.Character or {}) then return nil, nil end
    local closestPlayer, closestDistance, closestPart = nil, math.huge, nil
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local character = player.Character
        if not isCharacterValid(character) or not isAlive(character) or hasForceField(character) then continue end
        
        local bestPart = findBestTargetPart(character)
        if not bestPart then continue end
        
        local screenPos = Camera:WorldToViewportPoint(bestPart.Position)
        local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if distance < closestDistance and distance <= FOV_RADIUS then
            closestDistance, closestPlayer, closestPart = distance, player, bestPart
        end
    end
    return closestPlayer, closestPart
end

local function fireWeapon()
    local tool = getGunTool()
    if not tool then return end
    local gunScript = tool:FindFirstChild("GunScript")
    if gunScript and gunScript:IsA("LocalScript") then
        local fireEvent = tool:FindFirstChild("FireEvent") or tool:FindFirstChild("ShootEvent")
        if fireEvent and fireEvent:IsA("RemoteEvent") then
            fireEvent:FireServer()
        end
        UserInputService:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, 0, 0, true)
        wait(0.05)
        UserInputService:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, 0, 0, false)
    end
end

local function enableSilentAim()
    if silentAimEnabled then return end
    silentAimEnabled = true
    silentAimTarget, silentAimTargetPart = findSilentAimTarget()
    
    silentAimConnection = RunService.RenderStepped:Connect(function()
        if not silentAimEnabled then return end
        if not hasGunScript(LocalPlayer.Character or {}) then
            silentAimTarget, silentAimTargetPart = nil, nil
            return
        end
        
        if silentAimTarget then 
            updateSilentAimTarget() 
        end
        if not silentAimTarget or not silentAimTargetPart then
            silentAimTarget, silentAimTargetPart = findSilentAimTarget()
        end
        
        if silentAimTarget and silentAimTargetPart and silentAimTargetPart.Parent then
            if isOnScreen(silentAimTargetPart) and isInFOV(silentAimTargetPart) and isInRange(silentAimTargetPart) and hasLineOfSight(silentAimTargetPart, silentAimTarget.Character) then
                fireWeapon()
            end
        end
    end)
end

local function disableSilentAim()
    silentAimEnabled = false
    silentAimTarget, silentAimTargetPart = nil, nil
    if silentAimConnection then silentAimConnection:Disconnect(); silentAimConnection = nil end
end

local function toggleSilentAim()
    silentAimEnabled = not silentAimEnabled
    if silentAimEnabled then
        enableSilentAim()
    else
        disableSilentAim()
    end
    return silentAimEnabled
end

