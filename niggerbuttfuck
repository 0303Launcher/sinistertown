local function cycleFreezeMode()
    local modes = {"FULL", "ROTATION_ONLY", "GRAVITY_OFF"}
    local currentIndex = 0
    for i, mode in ipairs(modes) do
        if mode == freezeMode then currentIndex = i; break end
    end
    currentIndex = (currentIndex % #modes) + 1
    freezeMode = modes[currentIndex]
    if freezeActive then removeFreeze(); wait(0.1); applyFreeze() end
    return freezeMode
end

