UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    local key = input.KeyCode.Name
    local action = keyToAction[key]
    
    if action then
        if action == "Toggle GUI" then
            screenGui.Enabled = not screenGui.Enabled
        elseif action == "Quick Tween" then
            if not freezeActive then
                local dist = tweenDistance
                if revActive then dist = -dist end
                local oldPos = rootPart.Position
                moveCharacter(dist, false)
                wait(0.1)
                addHistory(oldPos); addHistory(rootPart.Position)
            end
        elseif action == "Quick Teleport" then
            if not freezeActive then
                local dist = tweenDistance
                if revActive then dist = -dist end
                local oldPos = rootPart.Position
                moveCharacter(dist, true)
                addHistory(oldPos); addHistory(rootPart.Position)
            end
        elseif action == "Reset Position" then
            if not freezeActive then
                rootPart.CFrame = CFrame.new(0, 5, 0)
            end
        elseif action == "Hide/Show GUI" then
            mainFrame.Visible = not mainFrame.Visible
        elseif action == "Toggle Freeze" then
            toggleFreeze()
            freezeIndicator.BackgroundColor3 = freezeActive and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
            freezeText.Text = freezeActive and "❄ FREEZE: ON" or "❄ FREEZE: OFF"
            freezeModeText.Text = "MODE: " .. freezeMode
            freezeActionBtn.BackgroundColor3 = freezeActive and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 100, 255)
        elseif action == "Cycle Freeze Mode" then
            cycleFreezeMode()
            freezeModeText.Text = "MODE: " .. freezeMode
        elseif action == "Toggle ESP" then
            espEnabled = not espEnabled
            for _, data in pairs(playerData) do
                if data.highlight then data.highlight.Enabled = espEnabled end
                if data.nametag then data.nametag.Enabled = espEnabled end
            end
            for _, child in ipairs(espContent:GetChildren()) do
                if child:IsA("TextButton") and child.Text:find("ESP:") then
                    child.Text = "👁 ESP: " .. (espEnabled and "ON" or "OFF")
                    child.BackgroundColor3 = espEnabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(30, 30, 45)
                end
            end
        elseif action == "Toggle SafeZone ESP" then
            espSafeZoneEnabled = not espSafeZoneEnabled
            for player, data in pairs(playerData) do
                updateHighlightColor(player)
            end
            for _, child in ipairs(espContent:GetChildren()) do
