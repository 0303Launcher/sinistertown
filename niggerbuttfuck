local function updateThirdPerson()
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- Calculate rotation
    local yawRad = math.rad(cameraYaw)
    local pitchRad = math.rad(cameraPitch)
    cameraPitch = math.clamp(cameraPitch, -80, 80)
    
    -- Direction vector
    local direction = Vector3.new(
        math.cos(pitchRad) * math.sin(yawRad),
        math.sin(pitchRad),
        math.cos(pitchRad) * math.cos(yawRad)
    )
    
    -- Camera position
    local camPos = rootPart.Position + Vector3.new(0, 1.5, 0) - direction * thirdPersonDistance
    
    -- Keep above ground
    if camPos.Y < 0.5 then
        camPos = Vector3.new(camPos.X, 0.5, camPos.Z)
    end
    
    -- Target CFrame
    targetCamCFrame = CFrame.lookAt(camPos, rootPart.Position + Vector3.new(0, 1.5, 0))
    
    -- Smooth interpolation
    if not currentCamCFrame then
        currentCamCFrame = targetCamCFrame
    end
    
    currentCamCFrame = currentCamCFrame:Lerp(targetCamCFrame, 0.15)
    
    -- Apply to camera
    Camera.CFrame = currentCamCFrame
    Camera.CameraType = Enum.CameraType.Scriptable
    Camera.CameraSubject = rootPart
end

local function enableThirdPerson()
    if thirdPersonEnabled then return end
    
    thirdPersonEnabled = true
    
    -- Reset camera angles
    cameraYaw = 0
    cameraPitch = -20
    currentCamCFrame = nil
    
    -- Create connection
    if not cameraConnection then
        cameraConnection = RunService.RenderStepped:Connect(updateThirdPerson)
    end
    
    -- Input for rotation
    if not cameraInputConnection then
        cameraInputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                isRotating = true
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                isRotating = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement and isRotating and thirdPersonEnabled then
                local delta = input.Delta
                cameraYaw = cameraYaw - delta.X * 0.3
                cameraPitch = cameraPitch - delta.Y * 0.3
                cameraPitch = math.clamp(cameraPitch, -80, 80)
            end
        end)
        
        -- Mouse wheel zoom
        UserInputService.MouseWheelBackward:Connect(function()
            if thirdPersonEnabled then
                thirdPersonDistance = math.min(thirdPersonDistance + 1, 30)
                -- Update UI
                updateThirdPersonUI()
            end
        end)
        
        UserInputService.MouseWheelForward:Connect(function()
            if thirdPersonEnabled then
                thirdPersonDistance = math.max(thirdPersonDistance - 1, 2)
                updateThirdPersonUI()
            end
        end)
    end
    
    -- Update UI
    updateThirdPersonUI()
end

local function disableThirdPerson()
    if not thirdPersonEnabled then return end
    
    thirdPersonEnabled = false
    
    -- Restore camera
    Camera.CameraType = Enum.CameraType.Custom
    Camera.CameraSubject = LocalPlayer.Character
    
    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end
    
    currentCamCFrame = nil
    targetCamCFrame = nil
    
    -- Update UI
    updateThirdPersonUI()
end

local function toggleThirdPerson()
