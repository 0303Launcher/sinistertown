    raycastParams.IgnoreWater = true
    local result = workspace:Raycast(origin, direction * distance, raycastParams)
    if result then return true, result.Instance, result.Position, result.Normal end
    return false, nil, nil, nil
end

local function bezierEasing(t, p1x, p1y, p2x, p2y)
    local function bezierPoint(t, p0, p1, p2, p3)
        local u = 1 - t
        return u*u*u*p0 + 3*u*u*t*p1 + 3*u*t*t*p2 + t*t*t*p3
    end
    local function solveCurveX(x, epsilon)
        local t = x
        for i = 1, 8 do
            local x2 = bezierPoint(t, 0, p1x, p2x, 1)
            if math.abs(x2 - x) < epsilon then return t end
            local dx = 3 * (1 - t) * (1 - t) * (p1x - 0) + 6 * (1 - t) * t * (p2x - p1x) + 3 * t * t * (1 - p2x)
            if dx == 0 then break end
            t = t - (x2 - x) / dx
        end
        return t
    end
    local epsilon = 1e-6
    local t = solveCurveX(t, epsilon)
    return bezierPoint(t, 0, p1y, p2y, 1)
end

local springVelocity = 0
local springPosition = 0
local function springEasing(t, stiffness, damping, mass)
    local target = 1
    local dt = 0.016
    local springForce = -stiffness * (springPosition - target)
    local dampingForce = -damping * springVelocity
    local acceleration = springForce / mass
    springVelocity = springVelocity + acceleration * dt
    springPosition = springPosition + springVelocity * dt
    return math.clamp(springPosition, 0, 1)
end

local function moveCharacter(distance, instant)
    if freezeActive then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local dir = getDirection()
    local targetPos = root.Position + dir * distance
    
    if obsActive then
        local blocked, hit, hitPos, normal = checkObstacle(root.Position, dir, distance)
        if blocked then
            local slideDir = (dir - normal * dir:Dot(normal)).Unit
            targetPos = root.Position + slideDir * distance * 0.8
            spawnParticles(hitPos, Color3.fromRGB(255, 200, 0), 20)
        end
    end
    
    if instant then
        root.CFrame = CFrame.new(targetPos, targetPos + dir)
        if partActive then spawnParticles(targetPos, Color3.fromRGB(255, 0, 200), 30) end
        if soundActive then playSound("rbxassetid://9120292758", 0.2) end
        return
    end
    
    local style, direction
    if tweenMode == "SMOOTH" then style, direction = Enum.EasingStyle.Quad, Enum.EasingDirection.Out
    elseif tweenMode == "EASE_OUT" then style, direction = Enum.EasingStyle.Quad, Enum.EasingDirection.Out
    elseif tweenMode == "EASE_IN" then style, direction = Enum.EasingStyle.Quad, Enum.EasingDirection.In
    elseif tweenMode == "EASE_IN_OUT" then style, direction = Enum.EasingStyle.Quad, Enum.EasingDirection.InOut
    elseif tweenMode == "ELASTIC" then style, direction = Enum.EasingStyle.Elastic, Enum.EasingDirection.Out
    elseif tweenMode == "BOUNCE" then style, direction = Enum.EasingStyle.Bounce, Enum.EasingDirection.Out
    elseif tweenMode == "BACK" then style, direction = Enum.EasingStyle.Back, Enum.EasingDirection.Out
    elseif tweenMode == "TELEPORT" then
        root.CFrame = CFrame.new(targetPos, targetPos + dir)
        if partActive then spawnParticles(targetPos, Color3.fromRGB(255, 0, 200), 30) end
        if soundActive then playSound("rbxassetid://9120292758", 0.2) end
        return
    else style, direction = Enum.EasingStyle.Quad, Enum.EasingDirection.Out
    end
    
    local repeats = 0
    if loopActive then repeats = -1 end
    
    local tweenInfo = TweenInfo.new(tweenDuration, style, direction, repeats, pingActive, tweenDelay)
    
    if tweenMode == "BEZIER" then
        local startCF = root.CFrame
        local endCF = CFrame.new(targetPos, targetPos + dir)
        local startTime = tick()
        if tweenDelay > 0 then wait(tweenDelay) end
        repeat
            local elapsed = tick() - startTime
            local t = math.min(elapsed / tweenDuration, 1)
            local eased = bezierEasing(t, 0.25, 0.1, 0.25, 1)
            root.CFrame = startCF:Lerp(endCF, eased)
            RunService.Heartbeat:Wait()
        until t >= 1
        root.CFrame = endCF
        if partActive then spawnParticles(targetPos, Color3.fromRGB(0, 255, 200), 30) end
        if soundActive then playSound("rbxassetid://9120292758", 0.2) end
        return
    elseif tweenMode == "SPRING" then
        local startCF = root.CFrame
        local endCF = CFrame.new(targetPos, targetPos + dir)
        local startTime = tick()
        springPosition, springVelocity = 0, 0
        if tweenDelay > 0 then wait(tweenDelay) end
        repeat
            local elapsed = tick() - startTime
            local t = math.min(elapsed / tweenDuration, 1)
            local eased = springEasing(t, 50, 10, 1)
            root.CFrame = startCF:Lerp(endCF, eased)
            RunService.Heartbeat:Wait()
        until t >= 1
        root.CFrame = endCF
        if partActive then spawnParticles(targetPos, Color3.fromRGB(255, 100, 255), 40) end
        if soundActive then playSound("rbxassetid://9120292758", 0.3) end
        return
    end
    
    local tween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos, targetPos + dir)})
    tween:Play()
    if partActive then
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if root and root.Position then spawnParticles(root.Position, Color3.fromRGB(0, 255, 200), 5) end
            if not tween or tween.PlaybackState == Enum.PlaybackState.Completed then conn:Disconnect() end
        end)
    end
    if soundActive then playSound("rbxassetid://9120292758", 0.15) end
    tween.Completed:Connect(function()
        if partActive then spawnParticles(targetPos, Color3.fromRGB(255, 0, 200), 30) end
        if soundActive then playSound("rbxassetid://9120292758", 0.2) end
    end)
end

local function addHistory(pos)
    table.insert(tweenHistory, pos)
    if #tweenHistory > maxHistory then table.remove(tweenHistory, 1) end
    historyIndex = #tweenHistory
end

