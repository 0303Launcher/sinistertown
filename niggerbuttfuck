-- Slider logic
local aimbotSliders = {
    {slider = fovSlider, fill = fovFill, input = fovInput, label = fovLabel, min = 30, max = 500, decimal = false, var = "FOV_RADIUS", labelText = "🎯 FOV SIZE:"},
    {slider = distAimSlider, fill = distAimFill, input = distAimInput, label = distAimLabel, min = 100, max = 1000, decimal = false, var = "MAX_DISTANCE", labelText = "🎯 MAX DISTANCE:"},
    {slider = dist3rdSlider, fill = dist3rdFill, input = dist3rdInput, label = dist3rdLabel, min = 2, max = 30, decimal = false, var = "thirdPersonDistance", labelText = "📏 3RD DISTANCE:"},
}

for _, s in ipairs(aimbotSliders) do
    local dragging = false
    local function updateSlider(input)
        local relative = (input.Position.X - s.slider.AbsolutePosition.X) / s.slider.AbsoluteSize.X
        relative = math.clamp(relative, 0, 1)
        local val
        if s.decimal then
            val = math.round((s.min + (s.max - s.min) * relative) * 100) / 100
            val = math.max(val, s.min)
        else
            val = math.round(s.min + (s.max - s.min) * relative)
        end
        s.fill.Size = UDim2.new(relative, 0, 1, 0)
        s.input.Text = tostring(val)
        s.label.Text = s.labelText .. " " .. tostring(val)
        _G[s.var] = val
        if s.var == "FOV_RADIUS" then updateFOVCircle() end
        if s.var == "thirdPersonDistance" then 
            thirdPersonDistance = val
        end
    end
    
    s.slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)
    s.slider.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    s.input.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local num = tonumber(s.input.Text)
            if num then
                num = math.clamp(num, s.min, s.max)
                if s.decimal then num = math.round(num * 100) / 100 else num = math.round(num) end
                s.input.Text = tostring(num)
                s.label.Text = s.labelText .. " " .. tostring(num)
                local rel = (num - s.min) / (s.max - s.min)
                s.fill.Size = UDim2.new(rel, 0, 1, 0)
                _G[s.var] = num
                if s.var == "FOV_RADIUS" then updateFOVCircle() end
                if s.var == "thirdPersonDistance" then 
                    thirdPersonDistance = num
                end
            else
                s.input.Text = s.label.Text:match("%d+%.?%d*")
            end
        end
    end)
end

