                label.TextColor3 = Color3.fromRGB(255, 255, 0)
                label.TextScaled = true
                label.Font = Enum.Font.GothamBold
                label.ZIndex = 101
                label.Parent = recordingUI
            end
            recordingUI.Visible = true
            
            local conn
            conn = UserInputService.InputBegan:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.Escape then
                    recordingUI.Visible = false
                    conn:Disconnect()
                    return
                end
                local keyName = input.KeyCode.Name
                if keyName ~= "Unknown" and keyName ~= "Escape" then
                    local conflict = false
                    for _, d in pairs(keybinds) do
                        if d.key == keyName and d.action ~= data.action then
                            conflict = true
                            break
                        end
                    end
                    if conflict then
                        keyBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
